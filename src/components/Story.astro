---
import { story } from '../data/profile';

const first = story[0];
const digits = String(first.year).split('');
const total = String(story.length).padStart(2, '0');
---

<section class="story" id="story" aria-labelledby="story-title" data-story style={`--hue:${first.hue}`}>
  <div class="story__blobs" aria-hidden="true"><i class="b1"></i><i class="b2"></i></div>

  <div class="shell story__grid">
    <div class="story__aside">
      <canvas class="story__bg" data-tunnel aria-hidden="true"></canvas>
      <div class="story__head" data-reveal>
        <p class="eyebrow">My journey</p>
        <h2 id="story-title">Rewind<br />the tape.</h2>
      </div>

      <div class="story__meter" aria-hidden="true">
        <div class="odo" data-odo>
          {
            digits.map((d) => (
              <span class="odo__col" style={`--n:${d}`}>
                <span class="odo__strip">
                  {Array.from({ length: 10 }, (_, k) => (
                    <span>{k}</span>
                  ))}
                </span>
              </span>
            ))
          }
        </div>
        <p class="mono story__range" data-range>{first.from} — {first.to}</p>
        <div class="story__progress">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9M2.5 2.5v2.6h2.6M8 5v3.2l2 1.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <b data-step>01</b><span>/ {total}</span>
          <span class="story__track"><i data-track></i></span>
        </div>
      </div>
    </div>

    <ol class="tl">
      {
        story.map((c, i) => (
          <li
            class:list={['tl__item', { 'is-active': i === 0, 'is-now': c.to === 'Now' }]}
            data-chapter={i}
            data-year={c.year}
            data-hue={c.hue}
            data-range={`${c.from} — ${c.to}`}
          >
            <span class="tl__dot" aria-hidden="true" />
            <p class="mono tl__when">
              {c.from} — {c.to}
            </p>
            <h3>{c.role}</h3>
            <p class="tl__org">{c.org}</p>
            <ul>
              {c.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .story {
    position: relative;
    padding-block: clamp(90px, 14vh, 160px) clamp(80px, 12vh, 140px);
    background:
      repeating-linear-gradient(-45deg, transparent 0 22px, color-mix(in srgb, var(--ink) 3%, transparent) 22px 23px),
      var(--paper);
    overflow: clip;
  }
  .story__blobs i {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    background: var(--hue);
    transition: background-color 1.2s var(--ease);
    pointer-events: none;
  }
  :global([data-theme='dark']) .story__blobs i {
    opacity: 0.16;
  }
  .b1 {
    width: 46vw;
    height: 46vw;
    left: -18vw;
    top: 4%;
  }
  .b2 {
    width: 40vw;
    height: 40vw;
    right: -16vw;
    bottom: 6%;
    animation: blob 14s ease-in-out infinite alternate;
  }
  @keyframes blob {
    to {
      transform: translate(-6vw, -8vh) scale(1.1);
    }
  }
  .story__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(24px, 5vw, 80px);
  }
  .story__aside {
    position: sticky;
    top: 110px;
    align-self: start;
  }
  .story__head h2 {
    margin-top: 14px;
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .story__meter {
    position: relative;
    margin-top: clamp(20px, 4vh, 40px);
  }
  /* The clock tunnel behind the year, drawn by the script below. It reaches well past the column
     and fades out towards its edges. */
  .story__bg {
    position: absolute;
    left: -40%;
    top: 50%;
    z-index: -1;
    width: 180%;
    height: 100svh;
    translate: 0 -50%;
    pointer-events: none;
    mask: radial-gradient(closest-side, #000 55%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .story__bg {
      display: none;
    }
  }
  .odo {
    position: relative;
    display: flex;
    font-size: clamp(76px, 10vw, 148px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .odo__col {
    display: inline-block;
    height: 1em;
    overflow: hidden;
  }
  .odo__strip {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--n) * -1em));
    transition: transform 0.9s var(--ease);
  }
  .odo__strip span {
    height: 1em;
  }
  .story__range {
    position: relative;
    margin-top: 10px;
  }
  .story__progress {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 14px;
    color: var(--muted);
  }
  .story__progress b {
    color: var(--ink);
    font-weight: 600;
  }
  .story__track {
    position: relative;
    width: 140px;
    height: 2px;
    margin-left: 14px;
    background: var(--line);
    border-radius: 2px;
  }
  .story__track i {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(var(--p, 0.125));
    transition: transform 0.6s var(--ease);
  }

  .tl {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 40px;
    border-left: 2px solid var(--line);
  }
  .tl__item {
    position: relative;
    padding-block: clamp(36px, 9vh, 80px);
    opacity: 0.38;
    transition: opacity 0.6s var(--ease);
  }
  :global(.tl__item.is-active) {
    opacity: 1;
  }
  .tl__dot {
    position: absolute;
    left: -51px;
    top: calc(clamp(36px, 9vh, 80px) + 42px);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid color-mix(in srgb, var(--ink) 35%, transparent);
    transition: background-color 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  :global(.tl__item.is-active) .tl__dot {
    background: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--ink) 10%, transparent);
  }
  :global(.tl__item.is-now) .tl__dot {
    background: var(--ok);
    border-color: var(--ok);
    box-shadow: 0 0 0 6px rgba(95, 179, 107, 0.2);
  }
  .tl__when {
    color: var(--muted);
  }
  .tl h3 {
    margin-top: 10px;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .tl__org {
    margin-top: 4px;
    color: var(--ink-2);
  }
  .tl ul {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    max-width: 48ch;
  }
  .tl ul li {
    position: relative;
    padding-left: 22px;
    color: var(--ink-2);
  }
  .tl ul li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .story__grid {
      grid-template-columns: 1fr;
    }
    .story__aside {
      display: contents;
    }
    .story__meter {
      position: sticky;
      top: 64px;
      z-index: 2;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin-inline: calc(var(--gutter) * -1);
      padding: 12px var(--gutter);
      background: color-mix(in srgb, var(--paper) 90%, transparent);
      backdrop-filter: blur(10px);
      border-block: 1px solid var(--line);
    }
    .story__bg {
      display: none;
    }
    .odo {
      font-size: 44px;
    }
    .story__range {
      margin-top: 0;
    }
    .story__progress {
      margin-top: 0;
      flex-basis: 100%;
    }
    .tl {
      padding-left: 28px;
    }
    .tl__dot {
      left: -39px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-story]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
    const cols = [...root.querySelectorAll<HTMLElement>('.odo__col')];
    const range = root.querySelector<HTMLElement>('[data-range]')!;
    const step = root.querySelector<HTMLElement>('[data-step]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const pad = (n: number) => String(n).padStart(2, '0');

    const show = (i: number) => {
      const el = items[i];
      items.forEach((it, k) => it.classList.toggle('is-active', k === i));
      String(el.dataset.year)
        .split('')
        .forEach((d, k) => cols[k]?.style.setProperty('--n', d));
      range.textContent = el.dataset.range ?? '';
      step.textContent = pad(i + 1);
      track.style.setProperty('--p', String((i + 1) / items.length));
      root.style.setProperty('--hue', el.dataset.hue ?? '');
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) show(items.indexOf(e.target as HTMLElement));
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    items.forEach((it) => io.observe(it));

    // The clock tunnel behind the year: dials recede into the distance, and scrolling carries you
    // deeper in (further into the past) while they wind backwards. Only drawn while the canvas is
    // shown, beside the timeline on wider screens.
    const cv = root.querySelector<HTMLCanvasElement>('[data-tunnel]');
    const ctx = cv?.getContext('2d');
    if (cv && ctx) {
      const html = document.documentElement;
      const tl = root.querySelector<HTMLElement>('.tl')!;
      const RINGS = 16;
      const GAP = 340;
      const FOCAL = 520;
      const R = 620;
      const LEN = RINGS * GAP;
      const dust = Array.from({ length: 70 }, () => ({
        a: Math.random() * Math.PI * 2,
        r: 120 + Math.random() * 760,
        z: Math.random() * LEN,
        s: 0.6 + Math.random() * 1.4,
      }));
      let W = 0;
      let H = 0;
      let dpr = 1;
      let rgb = '27,25,24';
      let raf = 0;

      const readInk = () => {
        const hex = getComputedStyle(html).getPropertyValue('--ink').trim().replace('#', '');
        const n = parseInt(hex, 16);
        if (hex.length === 6 && !Number.isNaN(n)) rgb = `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
      };
      const size = () => {
        dpr = Math.min(2, devicePixelRatio || 1);
        W = cv.clientWidth;
        H = cv.clientHeight;
        cv.width = W * dpr;
        cv.height = H * dpr;
      };

      const draw = (p: number) => {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);
        const cx = W * 0.5;
        const cy = H * 0.55;
        const k = Math.min(W, H) / 900;
        const camZ = p * (items.length - 1) * GAP * 1.6;
        const spin = -p * Math.PI * 1.5;
        const ticks = W < 768 ? 36 : 60;
        const every = ticks / 12;
        ctx.lineCap = 'round';
        for (let i = 0; i < RINGS; i++) {
          // Distance in front of the camera, recycled; each dial fades out before it reaches you.
          const z = ((((i * GAP - camZ) % LEN) + LEN) % LEN) + 60;
          const s = (FOCAL / z) * k;
          const fog = Math.min(1, Math.max(0, (z - 260) / 1100)) * Math.max(0, 1 - z / LEN);
          if (fog <= 0.01) continue;
          const rr = R * s;
          const rot = spin + i * 0.21;
          ctx.strokeStyle = `rgba(${rgb},${(fog * 0.12).toFixed(3)})`;
          ctx.lineWidth = Math.max(0.5, 1.2 * s);
          ctx.beginPath();
          ctx.arc(cx, cy, rr, 0, Math.PI * 2);
          ctx.stroke();
          // Clock ticks, long ones on the hours, batched into one path per kind.
          for (const hour of [false, true]) {
            const l = (hour ? 46 : 18) * s;
            ctx.beginPath();
            for (let j = 0; j < ticks; j++) {
              if ((j % every === 0) !== hour) continue;
              const a = rot + (j / ticks) * Math.PI * 2;
              const c = Math.cos(a);
              const d = Math.sin(a);
              ctx.moveTo(cx + c * (rr - l), cy + d * (rr - l));
              ctx.lineTo(cx + c * rr, cy + d * rr);
            }
            ctx.strokeStyle = `rgba(${rgb},${(fog * (hour ? 0.3 : 0.14)).toFixed(3)})`;
            ctx.lineWidth = Math.max(0.5, (hour ? 3 : 1.4) * s);
            ctx.stroke();
          }
          // A single hand on each dial.
          if (rr < Math.min(W, H) * 0.45) {
            const ha = rot * 3 + i;
            ctx.strokeStyle = `rgba(${rgb},${(fog * 0.16).toFixed(3)})`;
            ctx.lineWidth = Math.max(0.5, 2 * s);
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(cx + Math.cos(ha) * rr * 0.55, cy + Math.sin(ha) * rr * 0.55);
            ctx.stroke();
          }
        }
        // Dust drifting past.
        for (const q of dust) {
          const z = ((((q.z - camZ * 1.1) % LEN) + LEN) % LEN) + 40;
          const s = (FOCAL / z) * k;
          const fog = Math.min(1, Math.max(0, (z - 300) / 900)) * Math.max(0, 1 - z / LEN);
          const a = q.a + spin * 0.3;
          ctx.fillStyle = `rgba(${rgb},${(fog * 0.35).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(cx + Math.cos(a) * q.r * s, cy + Math.sin(a) * q.r * s, Math.max(0.4, q.s * s * 2.2), 0, Math.PI * 2);
          ctx.fill();
        }
      };

      // Progress runs from the first chapter to the last as each passes the middle of the screen.
      const update = () => {
        raf = 0;
        if (!cv.clientWidth) return;
        if (cv.clientWidth !== W || cv.clientHeight !== H) size();
        const first = items[0].offsetTop;
        const last = items[items.length - 1].offsetTop;
        const y = Math.min(last, Math.max(first, innerHeight * 0.5 - tl.getBoundingClientRect().top));
        draw((y - first) / Math.max(1, last - first));
      };
      const queue = () => {
        if (!raf) raf = requestAnimationFrame(update);
      };
      const recolour = () => {
        readInk();
        queue();
      };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      new MutationObserver(recolour).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolour);
      recolour();
    }
  }
</script>

---
import { profile } from '../data/profile';
---

<header class="hdr" data-header>
  <div class="shell hdr__row">
    <p class="pill hdr__clock" data-tz={profile.timezone}>
      <span class="hdr__muted">{profile.city}</span>
      <time data-clock-time>--:--</time>
      <span class="hdr__dot" aria-hidden="true"></span>
      <span class="hdr__date" data-clock-date></span>
    </p>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    padding-block: 18px;
    transition: padding 0.4s var(--ease);
  }
  .hdr::before {
    content: '';
    position: absolute;
    inset: 0 8px;
    border-radius: 0 0 26px 26px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line), 0 18px 40px -30px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(-100%);
    transition: opacity 0.4s var(--ease), transform 0.5s var(--ease);
  }
  :global(.hdr.is-scrolled) {
    padding-block: 10px;
  }
  :global(.hdr.is-scrolled)::before {
    opacity: 1;
    transform: none;
  }
  .hdr__row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    min-height: 40px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--chip);
    box-shadow: var(--shadow);
    font-size: 14px;
  }
  .hdr__clock {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .hdr__clock time {
    font-weight: 600;
    min-width: 5.2ch;
  }
  .hdr__muted {
    color: var(--muted);
  }
  .hdr__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--muted);
  }
  @media (max-width: 720px) {
    .hdr__dot,
    .hdr__date {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .hdr__clock {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const clock = document.querySelector<HTMLElement>('[data-tz]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  if (clock) {
    const tz = clock.dataset.tz;
    const timeFmt = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: 'numeric', minute: '2-digit', hour12: true });
    const dateFmt = new Intl.DateTimeFormat('en-GB', { timeZone: tz, day: 'numeric', month: 'long', year: 'numeric' });
    const tick = () => {
      const now = new Date();
      const t = timeFmt.format(now).replace(' ', '').toLowerCase();
      clock.querySelectorAll('[data-clock-time]').forEach((el) => (el.textContent = t));
      document.querySelectorAll('[data-local-time]').forEach((el) => (el.textContent = t));
      const d = clock.querySelector('[data-clock-date]');
      if (d) d.textContent = dateFmt.format(now);
    };
    tick();
    setInterval(tick, 15000);
  }
</script>

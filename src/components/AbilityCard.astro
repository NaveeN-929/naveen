---
import { Image } from 'astro:assets';
import avatar from '../assets/naveen.png';
import { profile, abilities } from '../data/profile';

const embers = Array.from({ length: 26 }, (_, i) => ({
  x: (i * 37) % 100,
  s: 7 + ((i * 13) % 9),
  d: -((i * 0.83) % 9).toFixed(2),
  z: 2 + (i % 3),
}));
---

<dialog class="ab" aria-label={`${profile.firstName}'s ability card`} data-ability>
  <div class="ab__embers" aria-hidden="true">
    {embers.map((e) => <i style={`--x:${e.x}%;--s:${e.s}s;--dl:${e.d}s;--z:${e.z}px`} />)}
  </div>

  <p class="ab__label"><span>{profile.name}</span><em>Ability card</em></p>
  <button class="ab__close" type="button" data-ability-close>
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
      <path d="M1.5 1.5l9 9M10.5 1.5l-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    Close
  </button>

  <div class="ab__stage">
    <div class="card" tabindex="0" role="button" aria-label="Flip the card" data-card>
      <div class="card__inner" data-card-inner>
        <div class="card__face card__front">
          <i class="card__gem g1"></i><i class="card__gem g2"></i><i class="card__gem g3"></i><i class="card__gem g4"></i>
          <div class="card__banner">{profile.name}</div>
          <div class="card__window">
            <Image src={avatar} alt="" widths={[320, 480]} sizes="320px" class="card__photo" />
            <span class="card__holo"></span>
          </div>
          <div class="card__type">{profile.headline}</div>
          <ul class="card__stats">
            {
              abilities.map((a) => (
                <li>
                  <span class="card__stat">{a.label}</span>
                  <span class="card__pips" aria-hidden="true">
                    {Array.from({ length: 10 }, (_, k) => (
                      <i class={k < Math.round(a.score / 10) ? 'on' : ''} />
                    ))}
                  </span>
                  <b>{a.score}</b>
                </li>
              ))
            }
          </ul>
          <div class="card__foot">
            <span><small>based</small>{profile.city}</span>
            <span><small>works</small>{profile.workMode}</span>
            <span><small>exp</small>4+ yrs</span>
          </div>
        </div>

        <div class="card__face card__back">
          <i class="card__gem g1"></i><i class="card__gem g2"></i><i class="card__gem g3"></i><i class="card__gem g4"></i>
          <span class="card__seal">{profile.initials}</span>
          <p class="card__motto">Ships pipelines you stop thinking about.</p>
          <dl class="card__lore">
            <div><dt>Speaks</dt><dd>{profile.languages.join(' · ')}</dd></div>
            <div><dt>Wields</dt><dd>AWS · Kubernetes · Terraform · Qdrant</dd></div>
            <div><dt>Summon</dt><dd>{profile.email}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <p class="ab__hint mono">Hover to tilt · drag to spin · double-click to flip</p>
</dialog>

<style>
  .ab {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: #f1e6cf;
    background: radial-gradient(60% 60% at 50% 45%, #2a1a10, #0b0705 70%);
    overflow: hidden;
  }
  .ab[open] {
    display: grid;
    place-items: center;
    animation: ab-in 0.5s var(--ease) both;
  }
  .ab::backdrop {
    background: transparent;
  }
  @keyframes ab-in {
    from {
      opacity: 0;
    }
  }
  .ab__embers i {
    position: absolute;
    left: var(--x);
    bottom: -10px;
    width: var(--z);
    height: var(--z);
    border-radius: 50%;
    background: #ffb26b;
    box-shadow: 0 0 8px 2px rgba(255, 150, 70, 0.6);
    animation: rise var(--s) linear infinite;
    animation-delay: var(--dl);
  }
  @keyframes rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    100% {
      transform: translate(40px, -105vh);
      opacity: 0;
    }
  }
  .ab__label {
    position: absolute;
    top: 22px;
    left: 24px;
    display: flex;
    flex-direction: column;
    font-size: 12px;
  }
  .ab__label span {
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #e7c98d;
  }
  .ab__label em {
    color: rgba(241, 230, 207, 0.55);
  }
  .ab__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(0, 0, 0, 0.4);
    font-size: 14px;
    font-weight: 500;
  }
  .ab__hint {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    text-align: center;
    color: rgba(241, 230, 207, 0.55);
    font-size: 10px;
  }

  .ab__stage {
    perspective: 1400px;
  }
  .card {
    container-type: inline-size;
    width: min(340px, 78vw, 52vh);
    aspect-ratio: 63 / 88;
    cursor: grab;
    touch-action: none;
    outline: none;
  }
  .card:active {
    cursor: grabbing;
  }
  .card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease);
  }
  :global(.card.is-dragging) .card__inner,
  :global(.card.is-tilting) .card__inner {
    transition-duration: 0.12s;
  }
  .card__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 2.6cqi;
    padding: 5cqi;
    border-radius: 5cqi;
    backface-visibility: hidden;
    background:
      radial-gradient(120% 80% at 50% 0%, #4a3550, transparent 60%),
      linear-gradient(160deg, #3a2a44, #22182c 60%, #2d2036);
    box-shadow:
      0 0 0 1.2cqi #e9c77e,
      0 0 0 2cqi #7a5521,
      0 0 0 2.6cqi #f3d892,
      0 40px 90px -30px rgba(0, 0, 0, 0.9),
      0 0 80px rgba(240, 180, 90, 0.25);
  }
  .card__face::before {
    content: '';
    position: absolute;
    inset: 2.4cqi;
    border: 1px solid rgba(233, 199, 126, 0.55);
    border-radius: 3.4cqi;
    pointer-events: none;
  }
  .card__gem {
    position: absolute;
    width: 3.4cqi;
    height: 3.4cqi;
    rotate: 45deg;
    background: linear-gradient(135deg, #ffeab0, #c99a46 55%, #6e4c1b);
    box-shadow: 0 0 6px rgba(255, 210, 130, 0.7);
  }
  .g1 { top: 1cqi; left: 1cqi; }
  .g2 { top: 1cqi; right: 1cqi; }
  .g3 { bottom: 1cqi; left: 1cqi; }
  .g4 { bottom: 1cqi; right: 1cqi; }
  .card__banner,
  .card__type,
  .card__stats,
  .card__foot {
    position: relative;
    border-radius: 2cqi;
    background: linear-gradient(180deg, #f6ecd2, #e3cf9f);
    color: #2a1d12;
    box-shadow: inset 0 0 0 1px rgba(122, 85, 33, 0.5), 0 0 0 0.8cqi rgba(233, 199, 126, 0.35);
  }
  .card__banner {
    padding: 2cqi;
    text-align: center;
    font-size: 6.4cqi;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .card__window {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: 2cqi;
    box-shadow: inset 0 0 0 0.8cqi #e9c77e, 0 0 0 0.6cqi #7a5521;
  }
  .card__window :global(.card__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .card__holo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at var(--mx, 50%) var(--my, 30%), rgba(255, 255, 255, 0.45), transparent 40%),
      conic-gradient(from 120deg at var(--mx, 50%) var(--my, 50%), #ff9fd1, #ffe08a, #9fffd1, #8ab8ff, #ff9fd1);
    mix-blend-mode: soft-light;
    opacity: 0.55;
  }
  .card__type {
    padding: 1.4cqi;
    text-align: center;
    font-family: var(--mono);
    font-size: 3cqi;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card__stats {
    list-style: none;
    margin: 0;
    padding: 2.4cqi 3cqi;
    display: grid;
    gap: 1.4cqi;
  }
  .card__stats li {
    display: grid;
    grid-template-columns: 1fr auto 6cqi;
    align-items: center;
    gap: 2cqi;
    font-size: 3.7cqi;
    font-weight: 600;
  }
  .card__stats b {
    text-align: right;
    font-size: 4.6cqi;
  }
  .card__pips {
    display: flex;
    gap: 0.9cqi;
  }
  .card__pips i {
    width: 1.5cqi;
    height: 1.5cqi;
    rotate: 45deg;
    border: 1px solid #7a5521;
  }
  .card__pips i.on {
    background: #2a1d12;
  }
  .card__foot {
    display: flex;
    justify-content: space-between;
    padding: 1.6cqi 2.6cqi;
    font-size: 3cqi;
    font-weight: 600;
  }
  .card__foot small {
    margin-right: 1cqi;
    font-weight: 400;
    opacity: 0.6;
  }
  .card__back {
    transform: rotateY(180deg);
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 5cqi;
  }
  .card__seal {
    display: grid;
    place-items: center;
    width: 34cqi;
    height: 34cqi;
    border-radius: 50%;
    font-size: 13cqi;
    font-weight: 700;
    color: #2a1d12;
    background: radial-gradient(circle at 35% 30%, #fff1c4, #d6ab5a 60%, #8a6226);
    box-shadow: 0 0 0 1.4cqi rgba(233, 199, 126, 0.3), 0 0 40px rgba(255, 200, 110, 0.5);
  }
  .card__motto {
    max-width: 24ch;
    font-size: 5cqi;
    font-weight: 600;
    color: #f6ecd2;
  }
  .card__lore {
    display: grid;
    gap: 2.4cqi;
    margin: 0;
    font-size: 3.4cqi;
  }
  .card__lore dt {
    font-family: var(--mono);
    font-size: 2.6cqi;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e7c98d;
  }
  .card__lore dd {
    margin: 0;
    color: rgba(246, 236, 210, 0.85);
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-ability]');
  const card = dlg?.querySelector<HTMLElement>('[data-card]');
  const inner = dlg?.querySelector<HTMLElement>('[data-card-inner]');

  if (dlg && card && inner) {
    let base = 0;
    let drag: { x: number; rot: number } | null = null;
    let moved = false;
    let lastTap = 0;

    const set = (rx: number, ry: number) => {
      inner.style.setProperty('--rx', `${rx}deg`);
      inner.style.setProperty('--ry', `${ry}deg`);
    };
    const flip = () => {
      base += 180;
      set(0, base);
    };

    document.querySelectorAll('[data-ability-open]').forEach((b) =>
      b.addEventListener('click', () => {
        base = 0;
        set(0, 0);
        dlg.showModal();
        card.focus();
      }),
    );
    dlg.querySelector('[data-ability-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      card.style.setProperty('--mx', `${px * 100}%`);
      card.style.setProperty('--my', `${py * 100}%`);
      if (drag) {
        const dx = e.clientX - drag.x;
        if (Math.abs(dx) > 3) moved = true;
        set(0, drag.rot + dx * 0.6);
      } else if (e.pointerType === 'mouse') {
        card.classList.add('is-tilting');
        set((0.5 - py) * 18, base + (px - 0.5) * 22);
      }
    });
    card.addEventListener('pointerleave', () => {
      card.classList.remove('is-tilting');
      if (!drag) set(0, base);
    });
    card.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, rot: base };
      moved = false;
      card.setPointerCapture(e.pointerId);
      card.classList.add('is-dragging');
    });
    const release = (e: PointerEvent) => {
      if (!drag) return;
      const rot = drag.rot + (e.clientX - drag.x) * 0.6;
      drag = null;
      card.classList.remove('is-dragging');
      if (moved) {
        base = Math.round(rot / 180) * 180;
        set(0, base);
        return;
      }
      // Double tap/click, detected by hand: pointer capture swallows dblclick on some devices.
      const now = performance.now();
      if (now - lastTap < 350) {
        lastTap = 0;
        flip();
      } else {
        lastTap = now;
      }
    };
    card.addEventListener('pointerup', release);
    card.addEventListener('pointercancel', () => {
      drag = null;
      card.classList.remove('is-dragging');
      set(0, base);
    });
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        flip();
      }
    });
  }
</script>

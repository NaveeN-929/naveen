---
import Base from '../../layouts/Base.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { doors, profile, type Door } from '../../data/profile';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return doors.map((door, i) => ({
    params: { slug: door.slug },
    props: { door, next: doors[(i + 1) % doors.length] },
  }));
}

interface Props {
  door: Door;
  next: Door;
}

const { door, next } = Astro.props;
---

<Base title={`${door.title} — ${profile.name}`} description={door.intro}>
  <section class="wk" style={`--door:${door.color}`}>
    <div class="shell">
      <a class="wk__back" href={withBase('/#work')}>
        <span aria-hidden="true">←</span> Back to the doors
      </a>
      <p class="mono wk__kicker" data-reveal>{door.kicker}</p>
      <h1 class="wk__title" data-reveal style="--d:0.05s">{door.title}</h1>
      <p class="wk__intro" data-reveal style="--d:0.1s">{door.intro}</p>
      <ul class="wk__points" data-reveal style="--d:0.15s">
        {door.points.map((p) => <li>{p}</li>)}
      </ul>

      <div class="wk__cases">
        {
          door.cases.map((c) => (
            <article class="case" data-reveal>
              <div class="case__text">
                <p class="mono case__kicker">{c.kicker}</p>
                <h2>{c.title}</h2>
                <p class="case__org">
                  {c.org} <span>· {c.meta}</span>
                </p>
                <p class="case__body">{c.body}</p>
                <ul class="case__tags">
                  {c.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                {c.link && (
                  <a class="btn case__link" href={c.link.href} target="_blank" rel="noopener">
                    {c.link.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
              <div class="case__visual" aria-hidden="true">
                {c.visual.kind === 'stat' ? (
                  <div class="stat">
                    <span class="stat__value">{c.visual.value}</span>
                    <span class="stat__label">{c.visual.label}</span>
                  </div>
                ) : (
                  <div class="term">
                    <div class="term__bar">
                      <i />
                      <i />
                      <i />
                    </div>
                    <pre>
                      {c.visual.lines.map((l, k) => (
                        <span style={`--k:${k}`}>{l}</span>
                      ))}
                    </pre>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <a class="wk__next" href={withBase(`/work/${next.slug}/`)} style={`--door:${next.color}`}>
        <span class="mono">Next door</span>
        <span class="wk__next-title">{next.title} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <ContactFooter slot="after" />
</Base>

<style>
  .wk {
    position: relative;
    padding-block: clamp(110px, 16vh, 150px) clamp(90px, 14vh, 140px);
  }
  .wk::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 70vh;
    background: radial-gradient(60% 80% at 20% 0%, color-mix(in srgb, var(--door) 22%, transparent), transparent 70%);
    pointer-events: none;
  }
  .wk > .shell {
    position: relative;
  }
  .wk__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--chip);
    font-size: 14px;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .wk__back:hover {
    transform: translateX(-3px);
  }
  .wk__kicker {
    margin-top: 40px;
    color: var(--muted);
  }
  .wk__title {
    margin-top: 12px;
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .wk__intro {
    max-width: 54ch;
    margin-top: 22px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .wk__points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .wk__points li {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 14px;
  }
  .wk__cases {
    display: grid;
    gap: 22px;
    margin-top: clamp(48px, 8vh, 80px);
  }
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .case__kicker {
    color: color-mix(in srgb, var(--door) 70%, var(--ink));
  }
  :global([data-theme='dark']) .case__kicker {
    color: color-mix(in srgb, var(--door) 45%, #fff);
  }
  .case h2 {
    margin-top: 12px;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .case__org {
    margin-top: 6px;
    font-weight: 500;
  }
  .case__org span {
    color: var(--muted);
    font-weight: 400;
  }
  .case__body {
    margin-top: 16px;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .case__tags li {
    padding: 5px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    font-size: 13px;
  }
  .case__link {
    margin-top: 22px;
  }
  .case__visual {
    min-height: 240px;
    border-radius: 20px;
    overflow: hidden;
    background:
      radial-gradient(80% 90% at 80% 10%, color-mix(in srgb, var(--door) 70%, #fff 0%), transparent 70%),
      linear-gradient(160deg, var(--door), #121110 120%);
    color: #f4efe9;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .stat {
    display: grid;
    gap: 8px;
    text-align: center;
  }
  .stat__value {
    font-size: clamp(64px, 8vw, 104px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .stat__label {
    max-width: 22ch;
    margin-inline: auto;
    color: rgba(244, 239, 233, 0.75);
  }
  .term {
    width: 100%;
    max-width: 380px;
    border-radius: 14px;
    background: rgba(10, 9, 8, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 50px -30px rgba(0, 0, 0, 0.8);
  }
  .term__bar {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .term__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }
  .term pre {
    margin: 0;
    padding: 16px 18px 20px;
    display: grid;
    gap: 6px;
    font-family: var(--mono);
    font-size: 12.5px;
    white-space: pre-wrap;
  }
  .term pre span {
    opacity: 0;
    animation: line 0.5s var(--ease) forwards;
    animation-delay: calc(0.3s + var(--k) * 0.35s);
  }
  .term pre span:first-child {
    color: #f2d998;
  }
  @keyframes line {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .wk__next {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: clamp(56px, 10vh, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .wk__next .mono {
    color: var(--muted);
  }
  .wk__next-title {
    font-size: clamp(34px, 5vw, 64px);
    font-weight: 600;
    letter-spacing: -0.045em;
    transition: color 0.3s;
  }
  .wk__next:hover .wk__next-title {
    color: color-mix(in srgb, var(--door) 80%, var(--ink));
  }
  @media (max-width: 820px) {
    .case {
      grid-template-columns: 1fr;
    }
    .case__visual {
      min-height: 200px;
    }
  }
</style>
